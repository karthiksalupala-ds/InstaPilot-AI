# --- App ---
APP_ENV=development
APP_NAME="InstaPilot AI"
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000

# --- Security ---
JWT_SECRET_KEY=change-me-in-production-min-32-chars
TOKEN_ENCRYPTION_KEY=change-me-fernet-or-32-byte-base64-key

# --- Database & Redis ---
POSTGRES_USER=instapilot
POSTGRES_PASSWORD=instapilot_dev_pass
POSTGRES_DB=instapilot
DATABASE_URL=postgresql+asyncpg://instapilot:instapilot_dev_pass@localhost:5432/instapilot
REDIS_URL=redis://localhost:6379/0

# --- LLM Providers (Global Dev Keys) ---
DEFAULT_LLM_PROVIDER=gemini
DEFAULT_LLM_MODEL=gemini-2.5-flash
GEMINI_API_KEY=
GROQ_API_KEY=

# --- Meta Instagram API (Configured in Phase 3) ---
META_APP_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=
META_LOGIN_CONFIG_ID=
META_REDIRECT_URI=http://localhost:8000/api/v1/instagram/oauth/callback

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
